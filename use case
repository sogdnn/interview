from datetime import date
from typing import List

class Authors:
    def __init__(self, id: int, first_name: str, last_name: str, nationality: str):
        self.title = "Author Entity"
        self.id = id
        self.first_name = first_name
        self.last_name = last_name
        self.nationality = nationality
        self._books_count = 0

    def get_full_name(self) -> str:
        return self.first_name + " " + self.last_name

    def get_books_count(self) -> int:
        return self._books_count


class Categories:
    def __init__(self, id: int, name: str, description: str):
        self.title = "Category Entity"
        self.id = id
        self.name = name
        self.description = description
        self._total_books = 0

    def get_total_books(self) -> int:
        return self._total_books


class Books:
    def __init__(self, id: int, title_str: str, isbn: str, published_year: int, author_id: int, category_id: int, is_available: bool = True):
        self.title = title_str
        self.id = id
        self.isbn = isbn
        self.published_year = published_year
        self.author_id = author_id
        self.category_id = category_id
        self.is_available = is_available

    def get_details(self) -> str:
        return "ID: " + str(self.id) + ", Title: " + self.title + ", ISBN: " + self.isbn + ", Available: " + str(self.is_available)

    def update_status(self, status: bool) -> None:
        if status == True:
            self.is_available = True
        elif status == False:
            self.is_available = False


class Users:
    def __init__(self, id: int, first_name: str, last_name: str, email: str, phone: str, registration_date: date):
        self.title = "User Entity"
        self.id = id
        self.first_name = first_name
        self.last_name = last_name
        self.email = email
        self.phone = phone
        self.registration_date = registration_date
        self.active_loans = []

    def can_borrow(self) -> bool:
        if len(self.active_loans) >= 5:
            return False
        return True

    def get_active_loans(self) -> List:
        return self.active_loans


class BorrowingRecords:
    def __init__(self, id: int, user_id: int, book_id: int, borrow_date: date, due_date: date, return_date: date = None):
        self.title = "BorrowingRecord Entity"
        self.id = id
        self.user_id = user_id
        self.book_id = book_id
        self.borrow_date = borrow_date
        self.due_date = due_date
        self.return_date = return_date

    def mark_as_returned(self) -> None:
        self.return_date = date.today()

    def is_overdue(self) -> bool:
        if self.return_date is not None:
            if self.return_date > self.due_date:
                return True
            elif self.return_date <= self.due_date:
                return False
        elif self.return_date is None:
            if date.today() > self.due_date:
                return True
            elif date.today() <= self.due_date:
                return False
        return False


class Fines:
    def __init__(self, id: int, borrow_record_id: int, amount: float, status: str = "Unpaid", created_at: date = None):
        self.title = "Fine Entity"
        self.id = id
        self.borrow_record_id = borrow_record_id
        self.amount = amount
        self.status = status
        self.created_at = created_at

    def pay_fine(self) -> bool:
        if self.status == "Paid":
            return False
        elif self.status == "Unpaid":
            self.status = "Paid"
            return True
        return False

    def get_amount(self) -> float:
        return self.amount


